#include <Adafruit_NeoPixel.h>

// Arduino UNO R3 / Nano clasico, ATmega328P.
const uint8_t PIN_X = A0, PIN_Y = A1, PIN_SW = 2;
const uint8_t PIN_MATRIZ = 6, PIN_BUZZER = 9;
const uint8_t MAX_PASOS = 20;
const bool SERPENTINA = false;
const bool INVERTIR_X = false, INVERTIR_Y = false;

Adafruit_NeoPixel matriz(64, PIN_MATRIZ, NEO_GRB + NEO_KHZ800);

struct Paso {
  uint8_t fila, columna, color;
};

enum Estado { LIBRE, MOSTRAR, JUGADOR, EXITO, ERROR_JUEGO, FINAL };

Estado estado = LIBRE;
Paso secuencia[MAX_PASOS];

uint8_t cantidad = 0, respuesta = 0;
uint8_t fila = 3, columna = 3, colorCursor = 2;
uint8_t record = 0;

bool continuar = false, movimientoHabilitado = false;
unsigned long inicioLibre = 0;

bool botonCrudo = HIGH, botonEstable = HIGH;
bool largoEmitido = false, pulsacionCorta = false, pulsacionLarga = false;

unsigned long cambioBoton = 0, inicioPulsacion = 0;
const uint16_t frecuencias[4] = {262, 330, 392, 523};

uint32_t colorRGB(uint8_t color) {
  switch (color) {
    case 0: return matriz.Color(255, 0, 0);
    case 1: return matriz.Color(0, 255, 0);
    case 2: return matriz.Color(0, 0, 255);
    default: return matriz.Color(255, 255, 0);
  }
}

uint8_t indiceLED(uint8_t f, uint8_t c) {
  // PICSimLab: filas progresivas desde la esquina inferior izquierda.
  return (7 - f) * 8 + c;
}

void apagarMatriz() {
  matriz.clear();
  matriz.show();
}

void dibujarCursor() {
  matriz.clear();
  matriz.setPixelColor(indiceLED(fila, columna), colorRGB(colorCursor));
  matriz.show();
}

// Llamar despues de una animacion que usa delay().
void sincronizarBoton() {
  botonCrudo = botonEstable = digitalRead(PIN_SW);
  cambioBoton = inicioPulsacion = millis();
  largoEmitido = (botonEstable == LOW);
  pulsacionCorta = pulsacionLarga = false;
}

void actualizarBoton() {
  pulsacionCorta = pulsacionLarga = false;

  unsigned long ahora = millis();
  bool lectura = digitalRead(PIN_SW);

  if (lectura != botonCrudo) {
    botonCrudo = lectura;
    cambioBoton = ahora;
  }

  if (ahora - cambioBoton >= 25 && botonEstable != botonCrudo) {
    botonEstable = botonCrudo;

    if (botonEstable == LOW) {
      inicioPulsacion = ahora;
      largoEmitido = false;
    } else if (!largoEmitido) {
      pulsacionCorta = true;
    }
  }

  if (botonEstable == LOW && !largoEmitido &&
      ahora - inicioPulsacion >= 800) {
    largoEmitido = true;
    pulsacionLarga = true;
  }
}

void moverCursor() {
  int x = analogRead(PIN_X), y = analogRead(PIN_Y);

  if (INVERTIR_X) x = 1023 - x;
  if (INVERTIR_Y) y = 1023 - y;

  // Una casilla por inclinacion. Volver al centro para otro movimiento.
  if (x >= 400 && x <= 624 && y >= 400 && y <= 624) {
    movimientoHabilitado = true;
    return;
  }

  if (!movimientoHabilitado) return;

  if (x < 350) {
    if (columna > 0) columna--;
  } else if (x > 674) {
    if (columna < 7) columna++;
  } else if (y < 350) {
    if (fila > 0) fila--;
  } else if (y > 674) {
    if (fila < 7) fila++;
  } else {
    return;
  }

  movimientoHabilitado = false;
  dibujarCursor();
}

void agregarPaso() {
  if (cantidad >= MAX_PASOS) return;

  secuencia[cantidad].fila = random(8);
  secuencia[cantidad].columna = random(8);
  secuencia[cantidad].color = random(4);
  cantidad++;
}

void animacion(uint8_t color, uint16_t frecuencia) {
  noTone(PIN_BUZZER);

  for (uint8_t vuelta = 0; vuelta < 3; vuelta++) {
    for (uint8_t i = 0; i < 64; i++)
      matriz.setPixelColor(i, colorRGB(color));

    matriz.show();
    tone(PIN_BUZZER, frecuencia);
    delay(180);

    noTone(PIN_BUZZER);
    apagarMatriz();
    delay(180);
  }

  sincronizarBoton();
}

void entrarLibre(bool entreNiveles) {
  estado = LIBRE;
  continuar = entreNiveles;
  inicioLibre = millis();
  movimientoHabilitado = false;
  dibujarCursor();
}

void setup() {
  pinMode(PIN_SW, INPUT_PULLUP);
  pinMode(PIN_BUZZER, OUTPUT);
  digitalWrite(PIN_BUZZER, LOW);

  Serial.begin(9600);
  matriz.begin();
  matriz.setBrightness(20);
  apagarMatriz();

  record = 0;
  Serial.println(F("Etapa 2: juego completo; record temporal en RAM."));
  Serial.println(F("Pulsa corto para cambiar color; manten 0.8 s para jugar."));

  sincronizarBoton();
  entrarLibre(false);
}

void loop() {
  actualizarBoton();

  switch (estado) {
    case LIBRE:
      moverCursor();

      if (pulsacionCorta) {
        // Elegir al azar uno de los otros tres colores.
        colorCursor = (colorCursor + 1 + random(3)) % 4;
        dibujarCursor();
        tone(PIN_BUZZER, frecuencias[colorCursor], 100);
      }

      if (pulsacionLarga || (continuar && millis() - inicioLibre >= 3000)) {
        noTone(PIN_BUZZER);

        if (!continuar) {
          randomSeed(micros() ^ ((unsigned long)analogRead(PIN_X) << 10)
                     ^ analogRead(PIN_Y));
          cantidad = 0;
        }

        agregarPaso();
        estado = MOSTRAR;
      }
      break;

    case MOSTRAR:
      Serial.print(F("Nivel: "));
      Serial.println(cantidad);

      apagarMatriz();
      delay(600);

      for (uint8_t i = 0; i < cantidad; i++) {
        matriz.setPixelColor(
          indiceLED(secuencia[i].fila, secuencia[i].columna),
          colorRGB(secuencia[i].color)
        );

        matriz.show();
        tone(PIN_BUZZER, frecuencias[secuencia[i].color]);
        delay(500);

        noTone(PIN_BUZZER);
        apagarMatriz();
        delay(200);
      }

      respuesta = 0;
      fila = columna = 3;
      movimientoHabilitado = false;

      sincronizarBoton();
      estado = JUGADOR;
      dibujarCursor();

      Serial.println(F("Tu turno: repite las posiciones y confirma con SW."));
      break;

    case JUGADOR:
      moverCursor();

      if (pulsacionCorta || pulsacionLarga) {
        if (fila != secuencia[respuesta].fila ||
            columna != secuencia[respuesta].columna) {
          estado = ERROR_JUEGO;
        } else {
          tone(PIN_BUZZER, frecuencias[secuencia[respuesta].color], 120);
          respuesta++;

          if (respuesta == cantidad) estado = EXITO;
        }
      }
      break;

    case EXITO:
      if (cantidad > record) record = cantidad;

      Serial.print(F("Nivel superado. Record: "));
      Serial.println(record);

      animacion(1, 880);

      if (cantidad == MAX_PASOS) {
        estado = FINAL;
      } else {
        entrarLibre(true);
        Serial.println(F("Siguiente nivel en 3 segundos."));
      }
      break;

    case ERROR_JUEGO:
      Serial.println(F("Error. Reiniciando desde nivel 1."));
      animacion(0, 110);

      cantidad = 0;
      agregarPaso();
      estado = MOSTRAR;
      break;

    case FINAL:
      Serial.println(F("Completaste los 20 niveles. Manten SW para otra partida."));
      animacion(3, 1047);
      entrarLibre(false);
      break;
  }
}
