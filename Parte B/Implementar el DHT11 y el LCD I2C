
#ifndef MAESTRO_IO_H
#define MAESTRO_IO_H

#include <stdint.h>
#include <stdbool.h>

#define LCD_ADDR 0x27

#define LCD_RS 0x01
#define LCD_EN 0x04
#define LCD_BACKLIGHT 0x08

void lcdBegin(void);
void imprimirLinea(uint8_t fila, const char *texto);

bool dht_leer(int16_t *temp, uint8_t *hum);

#endif

#define F_CPU 16000000UL

#include <avr/io.h>
#include <avr/interrupt.h>
#include <util/delay.h>
#include <stdint.h>
#include <stdbool.h>

#include "maestro_hw.h"
#include "maestro_io.h"

void lcdExpanderWrite(uint8_t dato)
{
    if (!twi_start())
    {
        twi_stop();
        return;
    }

    if (!twi_write(LCD_ADDR << 1))
    {
        twi_stop();
        return;
    }

    twi_write(dato | LCD_BACKLIGHT);
    twi_stop();
}

void lcdPulseEnable(uint8_t dato)
{
    lcdExpanderWrite(dato | LCD_EN);
    _delay_us(1);

    lcdExpanderWrite(dato & ~LCD_EN);
    _delay_us(50);
}

void lcdWrite4Bits(uint8_t dato)
{
    lcdPulseEnable(dato);
}

void lcdSend(uint8_t valor, uint8_t modo)
{
    lcdWrite4Bits(
        (valor & 0xF0) | modo
    );

    lcdWrite4Bits(
        ((valor << 4) & 0xF0) | modo
    );
}

void lcdCommand(uint8_t comando)
{
    lcdSend(comando, 0);
}

void lcdWriteChar(char caracter)
{
    lcdSend((uint8_t)caracter, LCD_RS);
}

void lcdSetCursor(uint8_t columna, uint8_t fila)
{
    const uint8_t offsets[] =
    {
        0x00,
        0x40
    };

    lcdCommand(
        0x80 | (columna + offsets[fila & 1])
    );
}

void lcdPrint(const char *texto)
{
    while (*texto)
    {
        lcdWriteChar(*texto++);
    }
}

void lcdBegin(void)
{
    _delay_ms(50);

    lcdExpanderWrite(0x00);

    lcdWrite4Bits(0x30);
    _delay_ms(5);

    lcdWrite4Bits(0x30);
    _delay_ms(5);

    lcdWrite4Bits(0x30);
    _delay_us(150);

    lcdWrite4Bits(0x20);

    lcdCommand(0x28);
    lcdCommand(0x08);
    lcdCommand(0x01);

    _delay_ms(2);

    lcdCommand(0x06);
    lcdCommand(0x0C);
}

void imprimirLinea(uint8_t fila, const char *texto)
{
    uint8_t longitud = 0;

    lcdSetCursor(0, fila);

    while (*texto && longitud < 16)
    {
        lcdWriteChar(*texto++);
        longitud++;
    }

    while (longitud < 16)
    {
        lcdWriteChar(' ');
        longitud++;
    }
}

bool dhtEsperarNivel(uint8_t nivel, uint16_t limite)
{
    while (limite--)
    {
        bool estado =
            (PIND & (1 << PIN_DHT)) != 0;

        if (estado == (nivel != 0))
            return true;

        _delay_us(1);
    }

    return false;
}

bool dht_leer(int16_t *temp, uint8_t *hum)
{
    uint8_t datos[5] = {0, 0, 0, 0, 0};

    DDRD |= (1 << PIN_DHT);
    PORTD &= ~(1 << PIN_DHT);

    _delay_ms(20);

    PORTD |= (1 << PIN_DHT);
    _delay_us(30);

    DDRD &= ~(1 << PIN_DHT);
    PORTD |= (1 << PIN_DHT);

    if (!dhtEsperarNivel(0, 200))
        return false;

    if (!dhtEsperarNivel(1, 200))
        return false;

    if (!dhtEsperarNivel(0, 200))
        return false;

    uint8_t interrupciones = SREG;
    cli();

    for (uint8_t i = 0; i < 40; i++)
    {
        if (!dhtEsperarNivel(1, 120))
        {
            SREG = interrupciones;
            return false;
        }

        _delay_us(35);

        datos[i / 8] <<= 1;

        if (PIND & (1 << PIN_DHT))
        {
            datos[i / 8] |= 1;
        }

        if (!dhtEsperarNivel(0, 120))
        {
            SREG = interrupciones;
            return false;
        }
    }

    SREG = interrupciones;

    uint8_t suma =
        datos[0] +
        datos[1] +
        datos[2] +
        datos[3];

    if (suma != datos[4])
        return false;

    *hum = datos[0];
    *temp = datos[2];

    return true;
}
