#ifndef ESCLAVO_SERVO_H
#define ESCLAVO_SERVO_H

#include <stdint.h>

#define ANGULO_REPOSO 10
#define ANGULO_PISTON 90
#define TIEMPO_PISTON_MS 500

void servo_init(void);
void servo_write(uint8_t angulo);

#endif

#include <avr/io.h>
#include <avr/interrupt.h>
#include <util/atomic.h>
#include <stdint.h>
#include <stdbool.h>

#include "esclavo_hw.h"
#include "esclavo_servo.h"

static volatile uint16_t pulsoServo = 2222;
static volatile bool pulsoAlto = false;

ISR(TIMER1_COMPA_vect)
{
    if (pulsoAlto)
    {
        PORTD &= ~(1 << SERVO);
        OCR1A = (40000 - pulsoServo) - 1;
        pulsoAlto = false;
    }
    else
    {
        PORTD |= (1 << SERVO);
        OCR1A = pulsoServo - 1;
        pulsoAlto = true;
    }
}

void servo_init(void)
{
    DDRD |= (1 << SERVO);
    PORTD &= ~(1 << SERVO);

    TCCR1A = 0;

    TCCR1B =
        (1 << WGM12) |
        (1 << CS11);

    TCNT1 = 0;
    OCR1A = 39999;

    TIMSK1 |= (1 << OCIE1A);
}

void servo_write(uint8_t angulo)
{
    if (angulo > 180)
        angulo = 180;

    uint16_t pulso =
        2000 + ((uint32_t)angulo * 2000UL) / 180UL;

    ATOMIC_BLOCK(ATOMIC_RESTORESTATE)
    {
        pulsoServo = pulso;
    }
}
