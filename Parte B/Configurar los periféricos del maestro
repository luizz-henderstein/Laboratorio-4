
#ifndef MAESTRO_HW_H
#define MAESTRO_HW_H

#include <stdint.h>
#include <stdbool.h>

#define PIN_DHT PD2
#define PIN_BOTON PD3
#define PIN_SS PB2

#define CMD_START 0x10
#define CMD_STOP 0x11
#define CMD_SET_SPEED 0x20
#define CMD_PISTON 0x30
#define CMD_EMERGENCY 0x40

#define ACK 0xA5

void hardware_init(void);
uint32_t millisC(void);

void uart_print(const char *texto);
void uart_numero(int32_t numero);
void uart_linea(const char *texto);

uint16_t adc_leer(uint8_t canal);

bool enviarTrama(uint8_t comando, uint8_t valor);

bool twi_start(void);
bool twi_write(uint8_t dato);
void twi_stop(void);

#endif

#include <avr/io.h>
#include <avr/interrupt.h>
#include <util/atomic.h>
#include <util/delay.h>
#include <stdio.h>

#include "maestro_hw.h"

static volatile uint32_t tiempoMs = 0;

ISR(TIMER2_COMPA_vect)
{
    tiempoMs++;
}

uint32_t millisC(void)
{
    uint32_t tiempo;

    ATOMIC_BLOCK(ATOMIC_RESTORESTATE)
    {
        tiempo = tiempoMs;
    }

    return tiempo;
}

void uart_char(char c)
{
    while (!(UCSR0A & (1 << UDRE0)));

    UDR0 = c;
}

void uart_print(const char *texto)
{
    while (*texto)
    {
        uart_char(*texto++);
    }
}

void uart_numero(int32_t numero)
{
    char buffer[15];

    snprintf(
        buffer,
        sizeof(buffer),
        "%ld",
        (long)numero
    );

    uart_print(buffer);
}

void uart_linea(const char *texto)
{
    uart_print(texto);
    uart_print("\r\n");
}

uint16_t adc_leer(uint8_t canal)
{
    ADMUX =
        (1 << REFS0) |
        (canal & 0x07);

    ADCSRA |= (1 << ADSC);

    while (ADCSRA & (1 << ADSC));

    return ADC;
}

uint8_t spi_transfer(uint8_t dato)
{
    SPDR = dato;

    while (!(SPSR & (1 << SPIF)));

    return SPDR;
}

bool enviarTrama(uint8_t comando, uint8_t valor)
{
    uint8_t respuesta;

    PORTB &= ~(1 << PIN_SS);

    _delay_us(5);

    spi_transfer(comando);
    spi_transfer(valor);

    respuesta = spi_transfer(0x00);

    _delay_us(5);

    PORTB |= (1 << PIN_SS);

    return respuesta == ACK;
}

bool twi_esperar(void)
{
    uint16_t limite = 60000;

    while (!(TWCR & (1 << TWINT)))
    {
        if (--limite == 0)
            return false;
    }

    return true;
}

bool twi_start(void)
{
    TWCR =
        (1 << TWINT) |
        (1 << TWSTA) |
        (1 << TWEN);

    return twi_esperar();
}

bool twi_write(uint8_t dato)
{
    TWDR = dato;

    TWCR =
        (1 << TWINT) |
        (1 << TWEN);

    return twi_esperar();
}

void twi_stop(void)
{
    TWCR =
        (1 << TWINT) |
        (1 << TWSTO) |
        (1 << TWEN);
}

void hardware_init(void)
{
    DDRD &= ~((1 << PIN_DHT) |
              (1 << PIN_BOTON));

    PORTD |=
        (1 << PIN_DHT) |
        (1 << PIN_BOTON);

    TCCR2A = (1 << WGM21);
    TCCR2B = (1 << CS22);
    OCR2A = 249;
    TIMSK2 = (1 << OCIE2A);

    UBRR0H = 0;
    UBRR0L = 103;

    UCSR0B = (1 << TXEN0);

    UCSR0C =
        (1 << UCSZ01) |
        (1 << UCSZ00);

    ADMUX = (1 << REFS0);

    ADCSRA =
        (1 << ADEN) |
        (1 << ADPS2) |
        (1 << ADPS1) |
        (1 << ADPS0);

    DDRB |=
        (1 << PB2) |
        (1 << PB3) |
        (1 << PB5);

    DDRB &= ~(1 << PB4);

    PORTB |= (1 << PIN_SS);

    SPCR =
        (1 << SPE) |
        (1 << MSTR) |
        (1 << SPR1);

    SPSR = 0;

    TWSR = 0;
    TWBR = 72;
    TWCR = (1 << TWEN);
}
