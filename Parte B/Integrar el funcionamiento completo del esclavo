
#define F_CPU 16000000UL

#include <avr/io.h>
#include <avr/interrupt.h>
#include <stdint.h>
#include <stdbool.h>

#include "esclavo_hw.h"
#include "esclavo_servo.h"

bool procesoActivo = false;
bool emergencia = false;
bool pistonExtendido = false;

uint8_t velocidad = 0;
uint32_t tRetornoPiston = 0;

void procesarComando(uint8_t comando, uint8_t valor)
{
    switch (comando)
    {
        case CMD_START:
            emergencia = false;
            procesoActivo = true;

            indicarMarcha();
            aplicarMotor(velocidad);
            break;

        case CMD_STOP:
            procesoActivo = false;

            apagarMotor();
            servo_write(ANGULO_REPOSO);

            pistonExtendido = false;
            indicarParo();
            break;

        case CMD_SET_SPEED:
            velocidad = valor;

            if (procesoActivo && !emergencia)
                aplicarMotor(velocidad);
            else
                apagarMotor();

            break;

        case CMD_PISTON:
            if (procesoActivo && !emergencia)
            {
                servo_write(ANGULO_PISTON);

                pistonExtendido = true;

                tRetornoPiston =
                    millisC() + TIEMPO_PISTON_MS;
            }
            break;

        case CMD_EMERGENCY:
            emergencia = true;
            procesoActivo = false;

            apagarMotor();
            servo_write(ANGULO_REPOSO);

            pistonExtendido = false;
            indicarEmergencia();
            break;

        default:
            break;
    }
}

int main(void)
{
    cli();

    hardware_init();
    servo_init();

    servo_write(ANGULO_REPOSO);

    sei();

    while (1)
    {
        uint8_t comando;
        uint8_t valor;

        if (spi_recibir(&comando, &valor))
        {
            procesarComando(comando, valor);
        }

        if (pistonExtendido &&
            (int32_t)(millisC() - tRetornoPiston) >= 0)
        {
            servo_write(ANGULO_REPOSO);
            pistonExtendido = false;
        }
    }
}
